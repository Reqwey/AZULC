# Copy this file to `.env` and replace the value with your own approved key.
# AZULC preserves `$` and `/` literally; neither character needs escaping.
AZULC_CURSEFORGE_API_KEY=''

# Register AZULC as a public-client application and enable the device-code flow.
# Do not reuse another launcher's Microsoft client ID.
AZULC_MICROSOFT_CLIENT_ID=''
